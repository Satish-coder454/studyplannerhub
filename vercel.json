{
  "buildCommand": "npm run build --prefix yourhub-react",
  "outputDirectory": "yourhub-react/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://your-backend-url.railway.app/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/yourhub-react/index.html"
    }
  ]
}
